# 统一仓库内为 LF；Windows 批处理保持 CRLF
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.sh  text eol=lf

# 二进制
*.png  binary
*.jpg  binary
*.pdf  binary
*.docx binary
*.xlsx binary
*.ttf  binary
*.ttc  binary

# GitHub 语言统计：设计原型与证据不计入
docs/** linguist-documentation
docs/design/*.html linguist-vendored
