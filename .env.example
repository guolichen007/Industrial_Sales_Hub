# 复制为 .env 后修改。不要把 .env 提交到 Git。
DJANGO_SECRET_KEY=请替换为50位以上随机字符串
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=sales.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://sales.example.com
POSTGRES_DB=ish
POSTGRES_USER=ish
POSTGRES_PASSWORD=请替换为强密码
# 甲方待确认事项（D2/D3）的开关，默认值见 docs/decisions/G0-决策记录.md
PERFORMANCE_CONFIRM_MODE=OR
SALES_QUOTE_SUMMARY=0
SALES_SEE_ALL_PROJECTS=0
# 报价 PDF 中文字体（容器内路径）。默认使用镜像内的 Noto Sans CJK
PDF_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
